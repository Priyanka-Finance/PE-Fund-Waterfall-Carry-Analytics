# Copy to .env and export the values (or set them in your shell).  Never commit .env.
#
# The Gen AI layer works without any key: with none set it uses the built-in
# offline writer, which is deterministic and needs no network.

# --- Option 1: Anthropic (Claude) -------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Option 2: any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, Ollama, vLLM ...) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1     # only for a non-OpenAI endpoint

# --- Optional overrides -----------------------------------------------------
# PEFUND_LLM_PROVIDER=anthropic                  # anthropic | openai | offline
# PEFUND_LLM_MODEL=claude-sonnet-5-5             # required for the openai provider
